#!/bin/sh
# performance settings shared by the DPI and IPS pages. Defaults chosen from the lab measurements (see nexwall-internal
# msp/PERFORMANCE_AND_INSPECTION.md): fast path on (connections are handed over only after DPI and IPS are done with them),
# larger NIC buffers on, packet steering on for more than one core. Each can be turned off in the Performance card.
if ! uci -q get nexwall_perf.main >/dev/null; then
	touch /etc/config/nexwall_perf
	uci -q batch <<EOI
set nexwall_perf.main=main
set nexwall_perf.main.fastpath='1'
set nexwall_perf.main.min_bytes='auto'
set nexwall_perf.main.ring_buffers='1'
commit nexwall_perf
EOI
fi
# packet steering: on for a new installation with more than one CPU core (measured on the lab: one core was saturated by
# the network card and steering took a single-queue NIC from 100 to about 700 Mbit/s); an existing choice is kept
if [ "$(grep -c ^processor /proc/cpuinfo)" -gt 1 ] && [ -z "$(uci -q get network.@globals[0].packet_steering)" ]; then
	uci -q get network.@globals[0] >/dev/null || uci -q set network.globals=globals
	uci -q set network.@globals[0].packet_steering='1'
	uci -q commit network
fi
/etc/init.d/nexwall-fastpath enable
exit 0
