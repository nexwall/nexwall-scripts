#!/bin/sh
# fwtrace - real-time firewall rule + NAT tracer for Nexwall (nftables/fw4).
#
# Watches ROUTED / NAT'd traffic and prints, once per flow: the decision (ACCEPT / DROP / REJECT),
# the rule that made it (the rule's name) and the REASON. Decisions by DPI, IP & Geo Blocking and
# the IPS hand-off are reported too, not only fw4 rules. NAT hops are correlated with conntrack.
#
# Hooks forward, dstnat, srcnat (not input: use drppkt for traffic to the firewall itself).
# Non-invasive: only a non-terminating `meta nftrace set 1` probe is inserted, removed on exit.
# Engine: lib/trace.awk (shared with drppkt), shell helpers: lib/common.sh.

NX_NAME=fwtrace
NX_LIBDIR=${NX_LIBDIR:-/usr/lib/nexwall-scripts}
[ -r "$NX_LIBDIR/common.sh" ] || NX_LIBDIR=$(dirname "$0")/../lib
. "$NX_LIBDIR/common.sh"

# prerouting first: every packet crosses it BEFORE the DPI chain, while dstnat only sees the first
# packet of a connection - without it a DPI reject on an established flow is never traced
CHAINS="prerouting forward dstnat srcnat"

usage() {
	cat <<USAGE
Usage: fwtrace [options] <filter...>
       fwtrace --cleanup

Filter tokens (join multiple with "and"):
  host <ip>              match as destination         src host <ip>   as source
  net <cidr>             match as destination network  src net <cidr>  as source
  port <n>               match as destination port     src port <n>    as source
  proto <tcp|udp|icmp>   restrict to a protocol        (IPv4 and IPv6 addresses accepted)

Options:
  -b, --both    also trace the reverse direction (where a DPI / IP-blocking verdict often appears)
  -i SECS       stop by itself after SECS seconds
  -j            one JSON object per line (used by the log viewer)
  --cleanup     remove leftover probe rules (e.g. after a killed run) and exit
  -h, --help    this help

Examples:
  fwtrace host 192.168.1.242
  fwtrace --both src host 192.168.1.102 and dst port 443 -i 30
  fwtrace dst port 22 and proto tcp
USAGE
	exit 1
}

NX_BOTH=0; NX_TIMEOUT=0; JSON=0
_args=""
while [ $# -gt 0 ]; do
	case "$1" in
		--cleanup) nx_remove_probes "fwtrace-" $CHAINS; echo "fwtrace: removed $NX_REMOVED leftover probe rule(s)"; exit 0 ;;
		-h|--help) usage ;;
		-b|--both) NX_BOTH=1; shift ;;
		-j) JSON=1; shift ;;
		-i) [ $# -ge 2 ] || usage; NX_TIMEOUT=$2; shift 2 ;;
		*) _args="$_args $1"; shift ;;
	esac
done
[ -n "$_args" ] || usage
case "$NX_TIMEOUT" in ''|*[!0-9]*) nx_die "-i needs a number of seconds" ;; esac

set -- $_args
nx_parse_filter "$@"
NX_TAG="fwtrace-$$"
nx_insert_probes $CHAINS
if [ "$JSON" != 1 ]; then
	echo "fwtrace: filter:$(nx_match 0)$( [ "$NX_BOTH" = 1 ] && echo '  (+ reverse direction)')"
	echo "fwtrace: tracing on:$NX_INSERTED  (Ctrl-C to stop)"
fi
nx_stream flow "$JSON" $NX_INSERTED
