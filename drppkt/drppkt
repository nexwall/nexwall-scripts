#!/bin/sh
# drppkt v3 - live packet trace for Nexwall (nftables/fw4).
# Reports the Rule ID (matched rule's name/comment) and NAT ID (matched NAT
# rule's name/comment) for each traced packet, via nftables' own tracer
# (nft monitor trace). Non-invasive: only inserts non-terminating
# `meta nftrace set 1` probes; never a drop/reject/accept. All probe rules
# and background helper processes are removed/killed on exit.

CHAIN_LIST="dstnat input forward"
TABLE=fw4
FAMILY=inet
TIMEOUT=0
PROTO=""

usage() {
	cat <<EOF
Usage: drppkt [-i seconds] <filter...>

Filter tokens (join multiple with "and"):
  host <ip>              match as destination
  src host <ip>          match as source
  dst host <ip>          match as destination
  net <cidr>             match as destination network
  src net <cidr>         match as source network
  dst net <cidr>         match as destination network
  port <n>               match as destination port
  src port <n>           match as source port
  dst port <n>           match as destination port
  proto <tcp|udp|icmp>   restrict to a protocol

Options:
  -i SECS   auto-stop and clean up after SECS seconds (default: until Ctrl-C)
  -h        show this help

Examples:
  drppkt host 10.10.10.1 and port 21
  drppkt src host 10.10.10.1
  drppkt dst host 192.168.1.10 and dst port 443
  drppkt net 10.0.0.0/24 -i 30
EOF
	exit 1
}

while getopts "i:h" opt; do
	case $opt in
		i) TIMEOUT=$OPTARG ;;
		h) usage ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] && usage

DIR=dst
HOST=""; NET=""; PORT=""
while [ $# -gt 0 ]; do
	case "$1" in
		and) shift ;;
		src) DIR=src; shift ;;
		dst) DIR=dst; shift ;;
		host) HOST=$2; HOSTDIR=$DIR; DIR=dst; shift 2 ;;
		net) NET=$2; NETDIR=$DIR; DIR=dst; shift 2 ;;
		port) PORT=$2; PORTDIR=$DIR; DIR=dst; shift 2 ;;
		proto) PROTO=$2; shift 2 ;;
		*) echo "Unrecognized filter token: $1" >&2; usage ;;
	esac
done

MATCH=""
[ -n "$PROTO" ] && MATCH="$MATCH meta l4proto $PROTO"
if [ -n "$HOST" ]; then
	if [ "$HOSTDIR" = "src" ]; then MATCH="$MATCH ip saddr $HOST"; else MATCH="$MATCH ip daddr $HOST"; fi
fi
if [ -n "$NET" ]; then
	if [ "$NETDIR" = "src" ]; then MATCH="$MATCH ip saddr $NET"; else MATCH="$MATCH ip daddr $NET"; fi
fi
if [ -n "$PORT" ]; then
	if [ "$PORTDIR" = "src" ]; then MATCH="$MATCH th sport $PORT"; else MATCH="$MATCH th dport $PORT"; fi
fi

if [ -z "$MATCH" ]; then
	echo "No usable filter parsed from: $*" >&2
	usage
fi

TAG="DRPPKT$$"
FIFO="/tmp/.drppkt.$$.fifo"
mkfifo "$FIFO" 2>/dev/null

echo "Filter: $MATCH"
echo "Tracing via chains: $CHAIN_LIST  (probe tag $TAG)"
echo "Ctrl-C to stop and remove the probe rules."
echo ""

INSERTED=""
for c in $CHAIN_LIST; do
	if nft insert rule $FAMILY $TABLE $c index 0 $MATCH meta nftrace set 1 comment "\"$TAG\"" 2>/dev/null \
	   || nft add rule $FAMILY $TABLE $c $MATCH meta nftrace set 1 comment "\"$TAG\"" 2>/dev/null; then
		INSERTED="$INSERTED $c"
	fi
done

if [ -z "$INSERTED" ]; then
	echo "Failed to insert any probe rule - check chain/table names and filter syntax." >&2
	rm -f "$FIFO"
	exit 1
fi

nft monitor trace > "$FIFO" 2>/dev/null &
TRACE_PID=$!

CLEANED=0
cleanup() {
	[ "$CLEANED" = "1" ] && return
	CLEANED=1
	kill "$TRACE_PID" 2>/dev/null
	[ -n "$AWK_PID" ] && kill "$AWK_PID" 2>/dev/null
	for c in $INSERTED; do
		H=$(nft -a list chain $FAMILY $TABLE $c 2>/dev/null | grep "$TAG" | grep -oE 'handle [0-9]+' | awk '{print $2}')
		[ -n "$H" ] && nft delete rule $FAMILY $TABLE $c handle $H 2>/dev/null
	done
	rm -f "$FIFO"
	echo ""
	echo "Stopped: probe rules removed from:$INSERTED"
}
trap cleanup EXIT INT TERM

if [ "$TIMEOUT" -gt 0 ] 2>/dev/null; then
	( sleep "$TIMEOUT"; kill -TERM $$ ) &
fi

awk '
{
	if (!match($0, /^trace id ([0-9a-f]+) ([a-z0-9]+) ([A-Za-z0-9_]+) ([A-Za-z0-9_]+) ([a-z]+)/, m)) next
	tid = m[1]; chn = m[4]; kind = m[5]
	if (kind != "rule" && kind != "policy") next

	verdict = "?"
	if (match($0, /\(verdict ([a-z]+)/, vm)) verdict = vm[1]

	comment = ""
	if (match($0, /comment "([^"]*)"/, cm)) comment = cm[1]

	label = "RULE"
	if (chn ~ /nat/) label = "NAT "

	if (comment == "") comment = "(unnamed rule)"

	printf "[%s] %s %-18s %-45s -> %s\n", tid, label, chn, comment, toupper(verdict)
	fflush()
}
' < "$FIFO" &
AWK_PID=$!

wait "$AWK_PID"
